{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3dstreaming.app/schemas/profile-v1.json",
  "title": "3Dstreaming sidecar profile",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "editionId", "fingerprint", "tracks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "editionId": { "type": "string", "minLength": 1 },
    "sourceHints": { "type": "array", "items": { "type": "string" } },
    "fingerprint": {
      "type": "object",
      "required": ["durationSeconds"],
      "properties": {
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "aspectRatio": { "type": "number", "exclusiveMinimum": 0 },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["atSeconds", "sha256"],
            "properties": {
              "atSeconds": { "type": "number", "minimum": 0 },
              "sha256": { "type": "string" }
            }
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "url"],
        "properties": {
          "kind": {
            "enum": ["depth", "disparity-left", "disparity-right", "convergence"]
          },
          "url": { "type": "string" },
          "codec": { "type": "string" },
          "fps": { "type": "number", "exclusiveMinimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "timeOffsetSeconds": { "type": "number" }
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "depthStrength": { "type": "number" },
        "convergence": { "type": "number" },
        "popOutLimit": { "type": "number" }
      }
    },
    "notes": { "type": "string" }
  }
}
