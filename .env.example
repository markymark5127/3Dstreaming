# TMDB application-level API Read Access Token.
# Used for title metadata/search and JustWatch-backed provider availability.
VITE_TMDB_READ_ACCESS_TOKEN=

# Watchmode API key.
# Used to resolve provider-specific direct web links for an exact title.
# For production, proxy this through your backend instead of exposing the key in a static client.
VITE_WATCHMODE_API_KEY=

# Login with Amazon client ID.
# Enables official Amazon OAuth identity verification for the Prime Video service card.
# This verifies Amazon identity only; Prime Video entitlement is still provider-owned.
VITE_AMAZON_LWA_CLIENT_ID=

# Chrome extension id for the optional provider-session confirmation bridge.
VITE_PROVIDER_BRIDGE_EXTENSION_ID=

# ISO 3166-1 country code used for streaming availability.
VITE_STREAMING_REGION=US
